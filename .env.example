# SkillPath AI - Environment Variables Example Template
# Copy this file to .env and replace with your actual production secrets

# Flask Session & CSRF Secret Key (Required in Production)
SECRET_KEY=replace_with_a_secure_random_hex_string_min_32_characters

# Google Gemini API Key (Optional for live LLM integrations)
GEMINI_API_KEY=

# Server Configuration
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000
